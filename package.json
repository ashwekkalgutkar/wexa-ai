{
  "name": "six-degrees-wexa",
  "version": "1.0.0",
  "private": true,
  "description": "Six Degrees of Collaboration — Music Artist Collaboration Graph built on CognoDB (openCypher)",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "seed": "cd backend && npm run seed",
    "build": "cd backend && npm install --include=dev && npm run build && cd ../frontend && npm install --include=dev && npm run build"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "neo4j-driver": "^5.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  }
}
